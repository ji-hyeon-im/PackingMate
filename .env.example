# Copy to the repository root as .env and replace the example password.
DB_NAME=packingmate
DB_USERNAME=packingmate
DB_PASSWORD=replace-with-a-local-password

# Local Spring Boot run (Compose uses the internal hostname `db`).
DB_URL=jdbc:postgresql://localhost:5432/packingmate
APP_PORT=8080

# External API (configure when integration is implemented)
GEMINI_API_KEY=
